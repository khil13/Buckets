# Supabase project (frontend-safe, publishable key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Server-side only: set these as Supabase Edge Function secrets, ---
# --- NEVER in this file or any committed .env. Documented here so ---
# --- the daily-sync function's expected env vars are discoverable. ---
# SPORTSGAMEODDS_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
